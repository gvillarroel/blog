---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data } = post;
const dateFormatter = new Intl.DateTimeFormat('en', {
  dateStyle: 'long',
  timeZone: 'UTC',
});
---

<BaseLayout
  title={data.title}
  description={data.summary}
  canonicalUrl={data.canonicalUrl}
>
  <article class="post-shell">
    <header class="post-header">
      {data.draft && <span class="draft-badge">Draft</span>}
      <p class="eyebrow">{data.tags.join(' · ')}</p>
      <h1>{data.title}</h1>
      <p class="post-summary">{data.summary}</p>
      <div class="post-meta">
        <span>{data.authors.join(', ')}</span>
        <span>Published {dateFormatter.format(data.pubDate)}</span>
        {data.updatedDate && <span>Updated {dateFormatter.format(data.updatedDate)}</span>}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    {data.references.length > 0 && (
      <section class="references" aria-labelledby="references-heading">
        <h2 id="references-heading">References</h2>
        <ol>
          {data.references.map((reference) => (
            <li>
              <a href={reference.url} rel="noreferrer">{reference.title}</a>
              {reference.accessed && (
                <span> — accessed {dateFormatter.format(reference.accessed)}</span>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}
  </article>
</BaseLayout>
